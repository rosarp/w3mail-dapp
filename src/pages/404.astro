---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Not found">
  <div class="grid min-h-[70dvh] place-items-center px-4 text-center">
    <div>
      <p class="text-sm font-semibold text-primary">404</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Page not found</h1>
      <p class="mt-2 text-sm text-fg-muted">The page you're looking for doesn't exist or has moved.</p>
      <Button href="/" class="mt-6" icon="chevron-left">Back home</Button>
    </div>
  </div>
</Layout>
