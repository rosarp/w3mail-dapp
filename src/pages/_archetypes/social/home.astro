---
import AddressAvatar from '../../../components/ui/AddressAvatar.astro';
/**
 * Social archetype — Home. A reference composition for agents, not a routed page (the
 * underscore directory is ignored by Astro routing). Mirror its structure on the real
 * home page:
 *
 *   1. AtmosphericBackground(glow) around a SplitHero — identity is the hero media.
 *   2. A stat strip tucked under the hero, overlapping it.
 *   3. A bento grid with ONE featured cell — never a uniform card grid.
 *   4. A full-bleed CTA band that breaks the page rhythm.
 *
 * Loading, designed-empty and error states are all shown. Data comes from real reads in
 * `load()`; empty arrays render the empty state — never seed data.
 */
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/sections/Section.astro';
import SplitHero from '../../../components/sections/SplitHero.astro';
import BentoGrid from '../../../components/sections/BentoGrid.astro';
import CTABanner from '../../../components/sections/CTABanner.astro';
import AtmosphericBackground from '../../../components/sections/AtmosphericBackground.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Skeleton from '../../../components/ui/Skeleton.astro';
import Alert from '../../../components/ui/Alert.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import Icon from '../../../components/ui/Icon.astro';
---

<Layout title="Home">
  <div x-data="socialHome">
    <AtmosphericBackground variant="glow">
      <Section spacing="loose" width="wide">
        <SplitHero
          eyebrow="Your space, on-chain"
          description="A social home where your posts, follows, and reactions live on-chain. Connect to pick up where you left off."
        >
          <Fragment slot="title">Everything you share, <span class="text-primary">owned by you</span>.</Fragment>
          <Fragment slot="actions">
            <template x-if="profile">
              <div class="flex flex-wrap gap-3">
                <Button x-on:click="compose()">New post</Button>
                <Button variant="secondary">View profile</Button>
              </div>
            </template>
            <template x-if="!profile">
              <Button x-on:click="$store.wallet.connect()">Connect to start</Button>
            </template>
          </Fragment>
          <div slot="media" class="rounded-xl bg-surface p-6 shadow-md">
            <template x-if="loading">
              <div>
                <div class="flex items-center gap-4">
                  <Skeleton class="size-14 rounded-full" />
                  <div class="flex-1 space-y-2">
                    <Skeleton class="h-4 w-32" />
                    <Skeleton class="h-3 w-24" />
                  </div>
                </div>
                <Skeleton class="mt-5 h-16 w-full" />
              </div>
            </template>
            <template x-if="!loading && !profile">
              <div class="text-center">
                <span class="mx-auto mb-3 inline-flex rounded-lg bg-primary-soft p-3 text-primary">
                  <Icon name="users" class="size-6" />
                </span>
                <p class="font-medium text-fg">Not connected</p>
                <p class="mt-1 text-sm text-fg-muted">Connect your wallet to see your profile here.</p>
              </div>
            </template>
            <template x-if="!loading && profile">
              <div>
                <div class="flex items-center gap-4">
                  <AddressAvatar addressExpr="profile.address" size={56} />
                  <div class="min-w-0">
                    <p class="truncate font-display text-xl font-semibold text-fg" x-text="`@${profile.handle}`"></p>
                    <p class="truncate text-sm text-fg-subtle" x-text="truncate(profile.address)"></p>
                  </div>
                </div>
                <p class="mt-5 text-sm text-fg-muted" x-show="profile.bio" x-text="profile.bio"></p>
              </div>
            </template>
          </div>
        </SplitHero>
      </Section>
    </AtmosphericBackground>

    <Section spacing="tight" width="wide">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4" x-show="loading">
        {Array.from({ length: 4 }, () => <Skeleton class="h-24" />)}
      </div>
      <dl class="relative z-10 -mt-16 grid grid-cols-2 gap-4 md:grid-cols-4" x-show="!loading && stats.length > 0" x-cloak>
        <template x-for="stat in stats" x-bind:key="stat.label">
          <div class="animate-rise rounded-xl border bg-surface p-5 shadow-md">
            <dt class="text-xs font-medium text-fg-muted" x-text="stat.label"></dt>
            <dd class="mt-2 font-display text-2xl font-semibold tabular text-fg" x-text="stat.value"></dd>
          </div>
        </template>
      </dl>
    </Section>

    <Section spacing="normal" width="wide">
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="font-display text-2xl font-semibold text-fg">Latest activity</h2>
        <Badge tone="primary" dot>Live</Badge>
      </div>

      <template x-if="loading">
        <BentoGrid>
          <Skeleton class="h-40 w-full rounded-xl md:col-span-2 md:row-span-2" />
          {Array.from({ length: 3 }, () => <Skeleton class="h-24 w-full rounded-xl" />)}
        </BentoGrid>
      </template>

      <template x-if="!loading && error">
        <Alert tone="danger" title="Couldn't load your activity">
          <span x-text="error"></span>
          <div class="mt-3"><Button variant="secondary" size="sm" x-on:click="load()">Try again</Button></div>
        </Alert>
      </template>

      <template x-if="!loading && !error && highlights.length === 0">
        <EmptyState
          icon="inbox"
          title="Nothing here yet"
          description="Your activity will appear here as you post, follow, and react. Make the first move."
        >
          <Button x-on:click="compose()">Create your first post</Button>
        </EmptyState>
      </template>

      <template x-if="!loading && !error && highlights.length > 0">
        <BentoGrid>
          <template x-for="(h, i) in highlights" x-bind:key="h.id">
            <div
              class="flex animate-rise flex-col rounded-xl border bg-surface p-5 shadow-sm"
              x-bind:class="i === 0 && 'md:col-span-2 md:row-span-2 p-7'"
            >
              <span class="mb-3 inline-flex w-fit rounded-lg bg-primary-soft p-2 text-primary">
                <template x-if="h.kind === 'post'"><Icon name="message-square" class="size-5" /></template>
                <template x-if="h.kind === 'follow'"><Icon name="user-plus" class="size-5" /></template>
                <template x-if="h.kind === 'reaction'"><Icon name="sparkles" class="size-5" /></template>
              </span>
              <p
                x-bind:class="i === 0 ? 'font-display text-xl font-semibold text-fg' : 'font-medium text-fg'"
                x-text="h.title"
              ></p>
              <span class="mt-auto pt-3 text-xs text-fg-subtle" x-text="h.meta"></span>
            </div>
          </template>
        </BentoGrid>
      </template>
    </Section>

    <Section spacing="loose" width="wide" bleed="bg-surface">
      <CTABanner
        title="Bring your circle on-chain"
        description="Invite the people you follow elsewhere. Their posts and yours, owned and portable."
      >
        <Button>Invite friends</Button>
        <Button variant="ghost">Learn how it works</Button>
      </CTABanner>
    </Section>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { truncateAddress } from '../../../lib/format.js';

  /**
   * @typedef {object} Profile
   * @property {string} address
   * @property {string} handle
   * @property {string} [bio]
   *
   * @typedef {object} Highlight
   * @property {string} id
   * @property {'post' | 'follow' | 'reaction'} kind
   * @property {string} title
   * @property {string} meta  Relative time, e.g. "2h".
   */

  Alpine.data('socialHome', () => ({
    loading: true,
    /** @type {string | null} */
    error: null,
    /** @type {Profile | null} */
    profile: null,
    /** @type {{ posts: number, followers: number, following: number, reactions: number } | null} */
    metrics: null,
    /** @type {Highlight[]} */
    highlights: [],

    get stats() {
      if (!this.metrics) return [];
      const m = this.metrics;
      return [
        { label: 'Posts', value: m.posts.toLocaleString() },
        { label: 'Followers', value: m.followers.toLocaleString() },
        { label: 'Following', value: m.following.toLocaleString() },
        { label: 'Reactions', value: m.reactions.toLocaleString() },
      ];
    },

    init() {
      this.load();
    },

    async load() {
      this.loading = true;
      this.error = null;
      try {
        this.profile = null;
        this.metrics = null;
        this.highlights = [];
      } catch (err) {
        this.error = err instanceof Error ? err.message : String(err);
      } finally {
        this.loading = false;
      }
    },

    compose() {},
    truncate: (address) => truncateAddress(address, 6, 4),
  }));
</script>
