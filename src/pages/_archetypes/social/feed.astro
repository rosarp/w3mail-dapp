---
import AddressAvatar from '../../../components/ui/AddressAvatar.astro';
/**
 * Social archetype — Feed. A reference composition for agents, not a routed page.
 * Mirror its structure on the real feed:
 *
 *   - PageHeader with a count badge.
 *   - An asymmetric body: a wide main column (inline compose, then the stream) beside a
 *     sticky side rail (trending, who to follow). The stream is a vertical timeline of
 *     varied posts, never a uniform card grid.
 *
 * Loading, designed-empty and error states are all shown. Data comes from real reads in
 * `load()`; empty arrays render the empty state — never seed data.
 */
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/sections/Section.astro';
import PageHeader from '../../../components/sections/PageHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import Skeleton from '../../../components/ui/Skeleton.astro';
import Alert from '../../../components/ui/Alert.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import Textarea from '../../../components/ui/Textarea.astro';
import Icon from '../../../components/ui/Icon.astro';
import ReactionBar from '../../../components/live/ReactionBar.astro';
---

<Layout title="Feed">
  <Section spacing="normal" width="wide">
    <div x-data="socialFeed">
      <PageHeader eyebrow="Feed" title="What's happening" description="A live stream of on-chain posts from people you follow.">
        <Badge x-text="`${posts.length} posts`">0 posts</Badge>
      </PageHeader>

      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          <template x-if="$store.wallet.isConnected">
            <Card>
              <Textarea label="Share something" placeholder="What's on your mind?" maxlength={280} showCount rows={3} x-model="draft" />
              <div class="mt-3 flex justify-end">
                <Button icon="message-square-plus" x-bind:disabled="!draft.trim()" x-on:click="publish()">Publish</Button>
              </div>
            </Card>
          </template>
          <template x-if="!$store.wallet.isConnected">
            <Alert tone="info" title="Connect to post">Connect your wallet to publish to the feed.</Alert>
          </template>

          <template x-if="loading">
            <div class="space-y-6">
              {
                Array.from({ length: 4 }, () => (
                  <div class="flex gap-4">
                    <Skeleton class="size-8 rounded-full" />
                    <div class="flex-1 space-y-2">
                      <Skeleton class="h-4 w-40" />
                      <Skeleton class="h-12 w-full" />
                    </div>
                  </div>
                ))
              }
            </div>
          </template>

          <template x-if="!loading && error">
            <Alert tone="danger" title="Couldn't load the feed">
              <span x-text="error"></span>
              <div class="mt-3"><Button variant="secondary" size="sm" x-on:click="load()">Try again</Button></div>
            </Alert>
          </template>

          <template x-if="!loading && !error && posts.length === 0">
            <EmptyState
              icon="message-square-plus"
              title="The feed is quiet"
              description="No posts yet from the accounts you follow. Be the first to say something, or follow more people."
            />
          </template>

          <template x-if="!loading && !error && posts.length > 0">
            <ol class="relative space-y-8 border-l border-border pl-8">
              <template x-for="post in posts" x-bind:key="post.id">
                <li class="relative animate-rise">
                  <span class="absolute top-0 -left-12 rounded-full ring-4 ring-bg"><AddressAvatar addressExpr="post.author.address" size={32} /></span>
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm text-fg">
                      <span class="font-semibold" x-text="`@${post.author.handle}`"></span>
                      <span class="text-fg-subtle">posted</span>
                    </p>
                    <span class="shrink-0 text-xs text-fg-subtle" x-text="post.createdAt"></span>
                  </div>
                  <p class="mt-2 text-base text-fg-muted" x-text="post.body"></p>
                  <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-fg-subtle">
                    <span class="inline-flex items-center gap-1"><Icon name="heart" class="size-3.5" /><span x-text="post.likes"></span></span>
                    <span class="inline-flex items-center gap-1"><Icon name="message-circle" class="size-3.5" /><span x-text="post.replies"></span></span>
                    <ReactionBar target="post.id" />
                  </div>
                </li>
              </template>
            </ol>
          </template>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
          <Card>
            <div class="mb-4 flex items-center gap-2">
              <Icon name="trending-up" class="size-4 text-primary" />
              <h3 class="font-semibold text-fg">Trending</h3>
            </div>
            <div class="space-y-3" x-show="loading">
              {Array.from({ length: 4 }, () => <Skeleton class="h-5 w-full" />)}
            </div>
            <p class="text-sm text-fg-subtle" x-show="!loading && trends.length === 0">No trends right now.</p>
            <ul class="space-y-3" x-show="!loading && trends.length > 0">
              <template x-for="t in trends" x-bind:key="t.id">
                <li class="flex items-baseline justify-between gap-2">
                  <span class="truncate font-medium text-fg" x-text="`#${t.topic}`"></span>
                  <span class="shrink-0 text-xs tabular text-fg-subtle" x-text="t.posts"></span>
                </li>
              </template>
            </ul>
          </Card>

          <Card title="Who to follow">
            <div class="space-y-4" x-show="loading">
              {
                Array.from({ length: 3 }, () => (
                  <div class="flex items-center gap-3">
                    <Skeleton class="size-9 rounded-full" />
                    <Skeleton class="h-4 flex-1" />
                  </div>
                ))
              }
            </div>
            <p class="text-sm text-fg-subtle" x-show="!loading && suggestions.length === 0">No suggestions yet.</p>
            <ul class="space-y-4" x-show="!loading && suggestions.length > 0">
              <template x-for="s in suggestions" x-bind:key="s.address">
                <li class="flex items-center gap-3">
                  <AddressAvatar addressExpr="s.address" size={36} />
                  <span class="min-w-0 flex-1 truncate font-medium text-fg" x-text="`@${s.handle}`"></span>
                  <Button variant="secondary" size="sm" icon="user-plus" x-on:click="follow(s.address)">Follow</Button>
                </li>
              </template>
            </ul>
          </Card>
        </aside>
      </div>
    </div>
  </Section>
</Layout>

<script>
  import Alpine from 'alpinejs';

  /**
   * @typedef {object} Post
   * @property {string} id
   * @property {{ address: string, handle: string }} author
   * @property {string} body
   * @property {string} createdAt  Relative time, e.g. "3m".
   * @property {number} likes
   * @property {number} replies
   */

  Alpine.data('socialFeed', () => ({
    loading: true,
    /** @type {string | null} */
    error: null,
    draft: '',
    /** @type {Post[]} */
    posts: [],
    /** @type {{ id: string, topic: string, posts: number }[]} */
    trends: [],
    /** @type {{ address: string, handle: string }[]} */
    suggestions: [],

    init() {
      this.load();
    },

    async load() {
      this.loading = true;
      this.error = null;
      try {
        this.posts = [];
        this.trends = [];
        this.suggestions = [];
      } catch (err) {
        this.error = err instanceof Error ? err.message : String(err);
      } finally {
        this.loading = false;
      }
    },

    async publish() {
      const body = this.draft.trim();
      if (!body) return;
      this.draft = '';
    },

    /** @param {string} address */
    async follow(address) {},
  }));
</script>
