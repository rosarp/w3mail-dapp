---
import Layout from '../../layouts/Layout.astro';
import MailShell from '../../components/mail/MailShell.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Skeleton from '../../components/ui/Skeleton.astro';
import Icon from '../../components/ui/Icon.astro';
import AddressAvatar from '../../components/ui/AddressAvatar.astro';
---

<Layout title="Contacts">
  <MailShell>
    <div x-data="contactsPage" class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <section class="min-w-0 animate-fade-in">
        <PageHeader title="Contacts" description="Names for the addresses you write to. Kept on this device.">
          <Button href="/contacts/edit/?return=/contacts/" variant="outline" icon="user-plus">Add contact</Button>
        </PageHeader>

        <div class="mt-6 space-y-4">
          <template x-if="error">
            <Alert tone="danger"><span x-text="error"></span></Alert>
          </template>

          <div x-show="loading" class="grid gap-3 sm:grid-cols-2">
            {
              Array.from({ length: 4 }).map(() => (
                <div class="flex items-center gap-3 rounded-xl border bg-surface p-4">
                  <Skeleton class="size-10 shrink-0 rounded-full" />
                  <div class="flex-1 space-y-2">
                    <Skeleton class="h-3.5 w-1/2" />
                    <Skeleton class="h-3 w-1/3" />
                  </div>
                </div>
              ))
            }
          </div>

          <div x-show="!loading && !error && contacts.length === 0" x-cloak>
            <Card>
              <EmptyState icon="users" title="No contacts yet" description="Save the people you write to, so you can pick them by name.">
                <Button href="/contacts/edit/?return=/contacts/" icon="user-plus">Add a contact</Button>
              </EmptyState>
            </Card>
          </div>

          <ul x-show="!loading && contacts.length > 0" x-cloak class="grid gap-3 sm:grid-cols-2">
            <template x-for="contact in contacts" :key="contact.id">
              <li class="flex items-center gap-3 rounded-xl border bg-surface p-4 shadow-sm">
                <AddressAvatar addressExpr="contact.address" size={40} class="shrink-0" />
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-fg" x-text="contact.name"></p>
                  <p class="truncate text-xs text-fg-subtle" x-text="short(contact.address)"></p>
                </div>
                <div class="flex shrink-0 gap-1">
                  <Button variant="ghost" size="sm" icon="pen-line" x-bind:href="writeHref(contact)" href="/compose/">Write</Button>
                  <Button variant="ghost" size="icon-sm" aria-label="Edit contact" x-bind:href="editHref(contact)" href="/contacts/edit/">
                    <Icon name="pencil" class="size-4" />
                  </Button>
                </div>
              </li>
            </template>
          </ul>
        </div>
      </section>

      <aside class="space-y-4 lg:pt-2 animate-slide-in">
        <Card>
          <p class="text-xs font-medium tracking-wider text-fg-subtle uppercase">Contacts</p>
          <p class="mt-2 font-display text-3xl font-semibold text-fg" x-text="loading ? '–' : contacts.length">–</p>
          <p class="text-sm text-fg-muted">saved on this device</p>
        </Card>
        <div class="rounded-xl border border-dashed p-4">
          <p class="flex items-center gap-2 text-sm font-medium text-fg">
            <Icon name="eye-off" class="size-4 text-fg-subtle" />
            Private to you
          </p>
          <p class="mt-1 text-sm text-fg-muted">Names you give contacts are never shared. Your mail shows them in place of addresses.</p>
        </div>
      </aside>
    </div>
  </MailShell>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { contactsPage } from '../../lib/pages/contacts.js';

  Alpine.data('contactsPage', contactsPage);
</script>
