---
/**
 * A deterministic gradient identicon: the same address always draws the same avatar.
 * `address` is fixed; `addressExpr` is an Alpine expression.
 *
 *   <AddressAvatar addressExpr="$store.wallet.address" size={28} />
 */
/**
 * @typedef {object} Props
 * @property {string} [address]
 * @property {string} [addressExpr]
 * @property {number} [size]  Pixels; default 32.
 * @property {string} [alt]  Accessible label; default the shortened address.
 * @property {string} [class]
 */

const { address = '', addressExpr, size = 32, alt, class: className } = Astro.props;
const read = addressExpr ?? JSON.stringify(address);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role="img"
  x-data={`addressAvatar(() => ${read}, ${JSON.stringify(alt ?? '')})`}
  x-bind:aria-label="label"
  aria-label={alt ?? 'Address avatar'}
  class:list={['shrink-0 overflow-hidden rounded-full bg-surface-3', className]}
>
  <defs>
    <linearGradient x-bind:id="look.id" x1="0" y1="0" x2="1" y2="1" x-bind:gradient-transform.camel="`rotate(${look.rot} 0.5 0.5)`">
      <stop offset="0%" x-bind:stop-color="look.c1"></stop>
      <stop offset="100%" x-bind:stop-color="look.c3"></stop>
    </linearGradient>
    <filter x-bind:id="`${look.id}b`" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="4"></feGaussianBlur>
    </filter>
  </defs>
  <rect width="32" height="32" x-bind:fill="`url(#${look.id})`"></rect>
  <g x-bind:filter="`url(#${look.id}b)`" opacity="0.9">
    <circle r="16" x-bind:cx="look.b1x" x-bind:cy="look.b1y" x-bind:fill="look.c2"></circle>
    <circle r="14" x-bind:cx="look.b2x" x-bind:cy="look.b2y" x-bind:fill="look.c3"></circle>
    <circle cx="26" cy="6" r="10" x-bind:fill="look.c2" opacity="0.5"></circle>
  </g>
</svg>
