---
/**
 * An inline message. `danger` announces itself as an alert; the other tones as status.
 */
/**
 * @typedef {object} Props
 * @property {'info' | 'success' | 'warning' | 'danger'} [tone]
 * @property {string} [title]
 * @property {boolean} [dismissible]
 * @property {string} [class]
 */
import Icon from './Icon.astro';

const { tone = 'info', title, dismissible = false, class: className } = Astro.props;

const tones = {
  info: { cls: 'bg-info-soft border-info/25 text-info', icon: 'info' },
  success: { cls: 'bg-success-soft border-success/25 text-success', icon: 'circle-check' },
  warning: { cls: 'bg-warning-soft border-warning/30 text-warning', icon: 'triangle-alert' },
  danger: { cls: 'bg-danger-soft border-danger/25 text-danger', icon: 'circle-alert' },
};
const t = tones[tone];
---

<div
  role={tone === 'danger' ? 'alert' : 'status'}
  class:list={['flex gap-3 rounded-xl border px-4 py-3', t.cls, className]}
  x-data="{ open: true }"
  x-show="open"
  x-transition.opacity
>
  <Icon name={t.icon} class="mt-0.5 size-4" />
  <div class="min-w-0 flex-1 text-sm">
    {title && <p class="font-medium">{title}</p>}
    <div class="text-fg-muted"><slot /></div>
  </div>
  {
    dismissible && (
      <button
        type="button"
        class="-m-1 grid size-7 place-items-center rounded-md text-fg-subtle hover:bg-black/5 hover:text-fg dark:hover:bg-white/10"
        x-on:click="open = false"
        aria-label="Dismiss"
      >
        <Icon name="x" class="size-3.5" />
      </button>
    )
  }
</div>
