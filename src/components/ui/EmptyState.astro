---
/**
 * What a list shows when it has nothing in it. Every list gets one; never a blank
 * panel. The default slot holds actions.
 */
/**
 * @typedef {object} Props
 * @property {string} title
 * @property {string} [description]
 * @property {string} [icon]  Lucide icon name; default "inbox".
 * @property {string} [class]
 * @property {unknown} [key] Extra attributes are spread onto the root element.
 */
import Icon from './Icon.astro';

const { title, description, icon = 'inbox', class: className, ...rest } = Astro.props;
---

<div class:list={['flex flex-col items-center justify-center px-6 py-12 text-center', className]} {...rest}>
  <span class="grid size-12 place-items-center rounded-xl border bg-surface-2 text-fg-subtle">
    <Icon name={icon} class="size-5" />
  </span>
  <h3 class="mt-4 text-sm font-semibold text-fg">{title}</h3>
  {description && <p class="mt-1 max-w-sm text-sm text-fg-muted">{description}</p>}
  {Astro.slots.has('default') && <div class="mt-5 flex gap-2"><slot /></div>}
</div>
