---
/**
 * A labelled native select. Options are strings or `{ value, label, disabled }`;
 * `placeholder` adds a disabled empty first option.
 */
/**
 * @typedef {string | { value: string, label: string, disabled?: boolean }} Option
 *
 * @typedef {object} Props
 * @property {Option[]} options
 * @property {string} [label]
 * @property {string} [value]
 * @property {string} [placeholder]
 * @property {string} [hint]
 * @property {string} [error]
 * @property {'sm' | 'md' | 'lg'} [size]
 * @property {string} [id]
 * @property {string} [name]
 * @property {string} [class]
 * @property {unknown} [key] Extra attributes are spread onto the select.
 */
import Icon from './Icon.astro';

const { label, options, value, placeholder, hint, error, size = 'md', class: className, id, name, ...rest } = Astro.props;
const selectId = id ?? (name ? `field-${name}` : undefined);
const opts = options.map((o) => (typeof o === 'string' ? { value: o, label: o } : o));
const sizes = { sm: 'h-8 text-xs', md: 'h-10 text-sm', lg: 'h-12 text-base' };
---

<div class:list={['grid gap-1.5', className]}>
  {label && <label for={selectId} class="text-xs font-medium text-fg">{label}</label>}
  <div class="relative">
    <select
      id={selectId}
      name={name}
      aria-invalid={error ? 'true' : undefined}
      class:list={[
        'w-full cursor-pointer appearance-none rounded-lg border border-border-strong/70 bg-surface pr-9 pl-3 text-fg shadow-sm',
        'focus:border-ring focus:ring-3 focus:ring-ring/20 focus:outline-none aria-invalid:border-danger',
        sizes[size],
      ]}
      {...rest}
    >
      {placeholder && <option value="" disabled selected={!value}>{placeholder}</option>}
      {opts.map((o) => <option value={o.value} disabled={o.disabled} selected={o.value === value}>{o.label}</option>)}
    </select>
    <Icon name="chevron-down" class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-fg-subtle" />
  </div>
  {(error || hint) && <p class:list={['text-xs', error ? 'text-danger' : 'text-fg-subtle']}>{error ?? hint}</p>}
</div>
