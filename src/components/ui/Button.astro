---
/**
 * A button, or a link styled as one when `href` is set. Any other attribute —
 * `x-on:click`, `disabled`, `aria-*` — is passed through.
 *
 * `loading` is an Alpine expression: while it is truthy the button is disabled and
 * shows a spinner in place of its leading icon.
 *
 *   <Button icon="plus" loading="saving" x-on:click="save()">Save</Button>
 */
/**
 * @typedef {object} Props
 * @property {'primary' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'link'} [variant]
 * @property {'sm' | 'md' | 'lg' | 'icon' | 'icon-sm'} [size]
 * @property {string} [href]
 * @property {string} [icon]  Leading Lucide icon name.
 * @property {string} [iconRight]  Trailing Lucide icon name.
 * @property {boolean} [block]  Full width.
 * @property {string} [loading]  Alpine expression.
 * @property {'button' | 'submit' | 'reset'} [type]
 * @property {string} [class]
 * @property {unknown} [key] Extra attributes are spread onto the root element.
 */
import Icon from './Icon.astro';

const {
  variant = 'primary',
  size = 'md',
  href,
  icon,
  iconRight,
  block = false,
  loading,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg font-medium select-none cursor-pointer ' +
  'transition-[background-color,border-color,color,box-shadow,opacity] duration-150 ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring ' +
  'disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50';

const variants = {
  primary: 'bg-primary text-primary-fg shadow-sm hover:bg-primary-hover',
  secondary: 'bg-surface-2 text-fg hover:bg-surface-3',
  outline: 'border border-border-strong/70 bg-surface text-fg shadow-sm hover:bg-surface-2',
  ghost: 'text-fg-muted hover:bg-surface-2 hover:text-fg',
  danger: 'bg-danger text-white shadow-sm hover:opacity-90',
  link: 'text-primary underline-offset-4 hover:underline px-0!',
};

const sizes = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-10 px-4 text-sm',
  lg: 'h-12 px-5 text-base',
  icon: 'size-10',
  'icon-sm': 'size-8',
};

const iconSize = size === 'sm' || size === 'icon-sm' ? 'size-3.5' : 'size-4';
const Tag = href ? 'a' : 'button';
const loadingAttrs = loading
  ? { 'x-bind:disabled': `!!(${loading})`, 'x-bind:aria-busy': `!!(${loading})` }
  : {};
---

<Tag
  class:list={[base, variants[variant], sizes[size], block && 'w-full', className]}
  href={href}
  type={href ? undefined : type}
  {...loadingAttrs}
  {...rest}
>
  {loading && <Icon name="loader-circle" class={`${iconSize} animate-spin`} x-show={loading} x-cloak />}
  {icon && (loading ? <Icon name={icon} class={iconSize} x-show={`!(${loading})`} /> : <Icon name={icon} class={iconSize} />)}
  <slot />
  {iconRight && <Icon name={iconRight} class={iconSize} />}
</Tag>
