---
/**
 * A label, a control in the default slot, and a hint or error beneath. Use it to
 * wrap controls that are not `Input`, `Textarea` or `Select` — a `BulletinImageUpload`,
 * a group of radios.
 */
/**
 * @typedef {object} Props
 * @property {string} label
 * @property {string} [for]  Id of the control the label names.
 * @property {boolean} [required]
 * @property {string} [hint]
 * @property {string} [error]
 * @property {string} [errorExpr]  Alpine expression yielding a message or "".
 * @property {string} [class]
 */

const { label, for: htmlFor, required = false, hint, error, errorExpr, class: className } = Astro.props;
---

<div class:list={['grid gap-1.5', className]}>
  <label for={htmlFor} class="text-xs font-medium text-fg">
    {label}
    {required && <span class="ml-0.5 text-danger" aria-hidden="true">*</span>}
  </label>
  <slot />
  {
    errorExpr ? (
      <p class="text-xs" role="alert" x-bind:class={`(${errorExpr}) ? 'text-danger' : 'text-fg-subtle'`} x-text={`(${errorExpr}) || ${JSON.stringify(hint ?? '')}`}>{hint}</p>
    ) : (
      (error || hint) && <p class:list={['text-xs', error ? 'text-danger' : 'text-fg-subtle']} role={error ? 'alert' : undefined}>{error ?? hint}</p>
    )
  }
</div>
