---
/**
 * A surface for grouped content. With `title`, `description` or an `actions` slot it
 * gets a header; a `footer` slot adds a footer. `interactive` lifts on hover — use it
 * when the whole card is a link or button.
 */
/**
 * @typedef {object} Props
 * @property {'default' | 'interactive' | 'outlined'} [variant]
 * @property {string} [title]
 * @property {string} [description]
 * @property {boolean} [padded]  Pad the body; default true.
 * @property {string} [href]  Render the card as a link.
 * @property {string} [class]
 * @property {unknown} [key] Extra attributes are spread onto the root element.
 */

const { variant = 'default', title, description, padded = true, href, class: className, ...rest } = Astro.props;
const hasHeader = title || description || Astro.slots.has('actions');
const Tag = href ? 'a' : 'section';

const variants = {
  default: 'border bg-surface shadow-sm',
  interactive: 'block border bg-surface shadow-sm cursor-pointer transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-md',
  outlined: 'border border-border-strong/70',
};
---

<Tag href={href} class:list={['rounded-xl', variants[variant], className]} {...rest}>
  {
    hasHeader && (
      <header class="flex items-start justify-between gap-4 border-b px-5 py-4">
        <div class="min-w-0">
          {title && <h2 class="text-sm font-semibold text-fg">{title}</h2>}
          {description && <p class="mt-0.5 text-xs text-fg-muted">{description}</p>}
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <slot name="actions" />
        </div>
      </header>
    )
  }
  <div class:list={[padded && 'p-5']}>
    <slot />
  </div>
  {
    Astro.slots.has('footer') && (
      <footer class="border-t px-5 py-3 text-xs text-fg-muted">
        <slot name="footer" />
      </footer>
    )
  }
</Tag>
