---
import { NAV } from '../../lib/nav.js';
import Icon from '../ui/Icon.astro';

/**
 * The main content frame of a page.
 *
 * - `top-nav` (default): a centred column, with a tab strip when `nav` has entries.
 * - `sidebar`: a left rail of `nav` beside the content.
 * - `full-width`: edge to edge, for immersive pages.
 *
 * Bottom padding on small screens always clears a fixed mobile tab bar.
 *
 * @typedef {import('../../lib/nav.js').NavItem} NavItem
 *
 * @typedef {object} Props
 * @property {'top-nav' | 'sidebar' | 'full-width'} [variant]
 * @property {NavItem[]} [nav]  Section navigation; defaults to none. Pass `NAV` for the app nav.
 * @property {string} [class]
 */

const { variant = 'top-nav', nav = [], class: className } = Astro.props;
const current = Astro.url.pathname;
const active = (/** @type {string} */ href) => current === href;
---

{
  variant === 'sidebar' && nav.length > 0 ? (
    <div class="flex min-h-[calc(100dvh-4rem)]">
      <aside class="hidden w-64 shrink-0 border-r bg-surface/50 md:block">
        <nav class="flex flex-col gap-1 p-4">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={active(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium transition-colors',
                active(item.href) ? 'bg-surface-2 text-fg' : 'text-fg-muted hover:bg-surface-3 hover:text-fg',
              ]}
            >
              {item.icon && <Icon name={item.icon} class="size-4" />}
              {item.label}
            </a>
          ))}
        </nav>
      </aside>
      <main class:list={['max-w-7xl flex-1 px-4 pt-8 pb-24 sm:px-8 md:pb-8', className]}>
        <slot />
      </main>
    </div>
  ) : (
    <>
      {nav.length > 0 && (
        <nav class="border-b bg-surface/30">
          <div class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 sm:px-6">
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={active(item.href) ? 'page' : undefined}
                class:list={[
                  'flex items-center gap-2 border-b-2 px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors',
                  active(item.href) ? 'border-primary text-fg' : 'border-transparent text-fg-muted hover:border-border hover:text-fg',
                ]}
              >
                {item.icon && <Icon name={item.icon} class="size-4" />}
                {item.label}
              </a>
            ))}
          </div>
        </nav>
      )}
      {variant === 'full-width' ? (
        <main class:list={['min-h-[calc(100dvh-4rem)] pb-24 md:pb-0', className]}>
          <slot />
        </main>
      ) : (
        <main class:list={['mx-auto max-w-7xl px-4 pt-8 pb-24 sm:px-8 md:pb-8', className]}>
          <slot />
        </main>
      )}
    </>
  )
}
