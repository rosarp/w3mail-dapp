---
import Icon from '../ui/Icon.astro';
import LogoSpinner from '../ui/LogoSpinner.astro';

/**
 * Renders `$store.tx`. Mounted once by Layout; never mount it yourself.
 */
---

<div
  x-data
  aria-live="polite"
  class="pointer-events-none fixed right-4 bottom-24 z-50 flex w-full max-w-sm flex-col-reverse gap-2 md:bottom-6"
>
  <template x-for="t in $store.tx.items" :key="t.id">
    <div
      class="pointer-events-auto animate-rise rounded-xl border bg-surface p-4 shadow-md"
      :class="{ 'border-success/30': t.status === 'confirmed', 'border-danger/30': t.status === 'failed', 'border-primary/30': t.status === 'pending' }"
    >
      <div class="flex gap-3">
        <div class="mt-0.5 shrink-0">
          <template x-if="t.status === 'pending'"><LogoSpinner size="sm" /></template>
          <template x-if="t.status === 'confirmed'"><Icon name="circle-check" class="size-5 text-success" aria-label="Confirmed" /></template>
          <template x-if="t.status === 'failed'"><Icon name="circle-x" class="size-5 text-danger" aria-label="Failed" /></template>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-medium text-fg" x-text="t.title"></p>
            <button
              type="button"
              class="shrink-0 rounded-sm p-0.5 text-fg-subtle transition-colors hover:bg-surface-2"
              x-on:click="$store.tx.dismiss(t.id)"
              aria-label="Dismiss"
            >
              <Icon name="x" class="size-3.5" />
            </button>
          </div>
          <p class="mt-0.5 text-sm text-fg-muted" x-show="t.message" x-text="t.message"></p>
          <a
            x-show="t.explorerUrl"
            :href="t.explorerUrl"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-flex items-center gap-1 text-sm text-primary hover:underline"
          >
            View transaction <Icon name="external-link" class="size-3" />
          </a>
        </div>
      </div>
      <div x-show="t.status === 'pending'" class="mt-3 h-1 overflow-hidden rounded-full bg-surface-2">
        <div class="h-full w-3/5 animate-pulse rounded-full bg-primary/60"></div>
      </div>
    </div>
  </template>
</div>
