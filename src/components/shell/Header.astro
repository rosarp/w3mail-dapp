---
import { SITE } from '../../lib/site.js';
import { NAV } from '../../lib/nav.js';
import Icon from '../ui/Icon.astro';
import BrandMark from './BrandMark.astro';
import AccountChip from '../wallet/AccountChip.astro';

/**
 * Sticky app header: brand, the navigation in `lib/nav.js`, theme toggle, account.
 */

const nav = NAV;
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b bg-surface/95 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <BrandMark size={24} />
      <span class="font-display text-lg font-semibold text-fg">{SITE.title}</span>
    </a>

    {
      nav.length > 0 && (
        <nav class="hidden items-center gap-1 md:flex">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                current === item.href ? 'bg-surface-2 text-fg' : 'text-fg-muted hover:bg-surface-2 hover:text-fg',
              ]}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="flex items-center gap-2" x-data>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-lg text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
        x-on:click="$store.theme.toggle()"
        x-bind:aria-label="$store.theme.isDark ? 'Switch to light theme' : 'Switch to dark theme'"
        aria-label="Toggle theme"
      >
        <Icon name="moon" class="size-5 dark:hidden" />
        <Icon name="sun" class="hidden size-5 dark:block" />
      </button>
      <AccountChip />
    </div>
  </div>
</header>
